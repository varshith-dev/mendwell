# PostgreSQL connection string. On Vercel the Neon integration injects this (pooled).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/mendwell?sslmode=require"
# Optional: direct (non-pooled) string used for the schema push and seed at build time.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/mendwell?sslmode=require"
# Optional: 32+ random characters. If unset in production, a secret is derived from DATABASE_URL.
# AUTH_SECRET="change-me-to-a-long-random-string"
