# PostgreSQL connection string. Neon: use the pooled string for the running app on Vercel,
# and the direct (non-pooled) string when you run `npm run setup` from your machine.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/mendwell?sslmode=require"
# Long random string, at least 32 characters. Signs the login cookie.
AUTH_SECRET="change-me-to-a-long-random-string"
